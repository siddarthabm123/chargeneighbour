SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-private-server-key
APP_URL=http://localhost:5180
# Optional; configure only after Google billing and Places API activation:
GOOGLE_PLACES_API_KEY=
# Public browser key: restrict to this site's HTTP referrers and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_ID=
# Set only after testing production SMTP; this flag alone does not configure SMTP.
EMAIL_SIGNIN_READY=false
BUSINESS_NAME=
SUPPORT_EMAIL=
PILOT_AREA=
# Comma-separated verified Supabase user UUIDs; never email addresses.
ADMIN_USER_IDS=
RATE_LIMIT_SECRET=
CRON_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep false until legal, support, host safety, live payment and acceptance gates pass.
COMMERCIAL_LAUNCH_APPROVED=false
